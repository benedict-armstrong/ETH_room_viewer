generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "linux-arm64-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  start_time DateTime @db.Timestamp(6)
  end_time   DateTime @db.Timestamp(6)
  room_id    Int
  room       Room     @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([start_time, end_time, room_id])
}

model MapData {
  id      Int     @id @default(autoincrement())
  points  String? @db.VarChar(10000)
  height  String? @db.VarChar(10)
  width   String? @db.VarChar(10)
  room_id Int     @unique
  room    Room    @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Room {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  building    String    @db.VarChar(127)
  area        String    @db.VarChar(127)
  region      String    @db.VarChar(127)
  floor       String    @db.VarChar(63)
  room_number String    @db.VarChar(63)
  capacity    Int?
  room_type   String    @db.VarChar(63)
  latitude    String?   @db.VarChar(63)
  longitude   String?   @db.VarChar(63)
  room_data   Boolean   @default(false)
  bookings    Booking[]
  map_data    MapData?
}
